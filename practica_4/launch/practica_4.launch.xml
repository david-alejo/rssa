<launch>
	<arg name="frame_id" default="map"/>
    <arg name="map" default="house"/>
    <arg name="map_file" default="$(find-pkg-share collision_avoidance)/maps/$(var map).yaml"/>
	
    <arg name="rviz" default="true"/>

    <include file="$(find-pkg-share turtlebot3_gazebo)/launch/turtlebot3_house.launch.py" />

    <node pkg="rviz2" name="rviz" exec="rviz2" args="-d $(find-pkg-share collision_avoidance)/cfg/practica_4.rviz" if="$(var rviz)" />

    <node pkg="turtlebot_controller" exec="turtlebot_controller" name="path_tracker">
		<param name="frame_id" value="$(var frame_id)"/>
        <remap from="cmd_vel" to="v_pref"/>
	</node>

    <!--Start the map server -->
 	<node name="map_server" pkg="nav2_map_server" exec="map_server" args="$(var map_file)"/>
	
	<!--Start the Montecarlo Localization module-->
    <arg name="init_x_mcl" default ="-3" />
    <arg name="init_y_mcl" default ="1"/>
    <arg name="init_a_mcl" default ="0"/>
	<node pkg="nav2_amcl" exec="amcl" name="amcl" >
		<param name="initial_pose_x" value="$(var init_x_mcl)" /> 
        <param name="initial_pose_y" value="$(var init_y_mcl)" />
		<param name="initial_pose_a" value="$(var init_a_mcl)" />
	</node>

    <!-- Start the collision avoidance node (can change depending on the method)-->
    <node pkg="collision_avoidance" name="collision_avoidance" exec="emergency_stop" output="screen" />
</launch>
